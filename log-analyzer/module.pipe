export fn log_analyze logs
    classified: ai_batch "Classify this log line as: normal, warning, error, critical. Answer ONLY with the category." logs
    counts: {}
    for k in classified
        c: get counts k
        if is_nil c
            c: 0
        set counts k (c + 1)
    counts

export fn log_summarize logs
    lines: to_str (len logs)
    summarize ("Analyze these " ++ lines ++ " server log entries. What issues do you see?")
