-- ============================================================
-- rag-pipe — RAG (Retrieval-Augmented Generation) for Pipe
-- v1.1.0 — metadata + document management
-- Exports: index_create, index_add, index_add_doc,
--          index_list, index_get, index_delete, index_count,
--          index_search, index_ask
-- Requires: pipe -get sqlite  (installs sqlite.pipe into ~/.pipe/modules/)
-- ============================================================

import "sqlite.pipe"

--- === Schema === ---

fn ensure_schema h name
    try
        db_query h ("SELECT title FROM " ++ name)
    catch e
        try
            db_exec h ("DROP TABLE " ++ name)
        catch e2
            print ""
        db_exec h ("CREATE TABLE " ++ name ++ " (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT, source TEXT, tags TEXT, content TEXT, vector TEXT, created TEXT)")

export fn index_create h name
    ensure_schema h name
    {handle: h, table: name}

--- === Add Documents === ---

fn now_str
    format_time (now) "2006-01-02 15:04:05"

export fn index_add idx text
    index_add_doc idx "" "" "" text

export fn index_add_doc idx title source tags text
    h: get idx "handle"
    tn: get idx "table"
    if text == "" || text == nil
        return 0
    vec: embed text
    vec_json: to_json vec
    created: now_str 0
    sql: "INSERT INTO " ++ tn ++ " (title, source, tags, content, vector, created) VALUES ('"
    sql: sql ++ (esc_sql title) ++ "', '" ++ (esc_sql source) ++ "', '" ++ (esc_sql tags) ++ "', '" ++ (esc_sql text) ++ "', '" ++ vec_json ++ "', '" ++ created ++ "')"
    db_exec h sql

--- === List / Get / Delete / Count === ---

fn row_to_item r
    item: {}
    set item "id" (get r "id")
    set item "title" (get r "title")
    set item "source" (get r "source")
    set item "tags" (get r "tags")
    set item "created" (get r "created")
    content: get r "content"
    set item "size" (len content)
    if (len content) > 120
        set item "snippet" ((substring content 0 120) ++ "...")
    else
        set item "snippet" content
    item

export fn index_list idx
    h: get idx "handle"
    tn: get idx "table"
    rows: db_query h ("SELECT id, title, source, tags, content, created FROM " ++ tn ++ " ORDER BY id DESC")
    items: []
    i: 0
    while i < (len rows)
        push items (row_to_item (at rows i))
        i: i + 1
    items

export fn index_get idx id
    h: get idx "handle"
    tn: get idx "table"
    rows: db_query h ("SELECT id, title, source, tags, content, created FROM " ++ tn ++ " WHERE id = " ++ (to_str id))
    if (len rows) == 0
        nil
    else
        row_to_item (at rows 0)

export fn index_delete idx id
    h: get idx "handle"
    tn: get idx "table"
    db_exec h ("DELETE FROM " ++ tn ++ " WHERE id = " ++ (to_str id))

export fn index_count idx
    h: get idx "handle"
    tn: get idx "table"
    rows: db_query h ("SELECT id FROM " ++ tn)
    len rows

--- === Search === ---

export fn index_search idx query k
    h: get idx "handle"
    tn: get idx "table"

    if k == nil
        k: 3

    rows: db_query h ("SELECT id, title, source, tags, content, vector FROM " ++ tn)
    if (len rows) == 0
        return []

    ids: []
    titles: []
    sources: []
    tags: []
    texts: []
    vectors: []
    i: 0
    while i < (len rows)
        r: at rows i
        push ids (get r "id")
        push titles (get r "title")
        push sources (get r "source")
        push tags (get r "tags")
        push texts (get r "content")
        push vectors (parse_json (get r "vector"))
        i: i + 1

    qvec: embed query
    top_indices: nearest qvec vectors k

    results: []
    i: 0
    while i < (len top_indices)
        idx_val: at top_indices i
        result: {}
        set result "id" (at ids idx_val)
        set result "title" (at titles idx_val)
        set result "source" (at sources idx_val)
        set result "tags" (at tags idx_val)
        set result "text" (at texts idx_val)
        set result "score" (cosine_sim qvec (at vectors idx_val))
        push results result
        i: i + 1

    results

--- === Ask (Search + AI) === ---

export fn index_ask idx question
    results: index_search idx question 3

    if (len results) == 0
        return ask question

    context: ""
    i: 0
    while i < (len results)
        r: at results i
        context: context ++ (get r "text")
        context: context ++ "\n---\n"
        i: i + 1

    prompt: "Context:\n" ++ context ++ "\nQuestion: " ++ question ++ "\nAnswer based on the context above."
    ask prompt

--- === Helpers === ---

fn esc_sql s
    replace_all s "'" "''"
