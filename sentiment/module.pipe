-- Sentiment Analysis Module
-- Usage: import "..."; text > analyze_sentiment

export fn analyze_sentiment text
    classify text ["positive", "neutral", "negative"]

export fn batch_sentiment texts
    ai_batch "Classify sentiment as: positive, neutral, negative. Answer ONLY with the category." texts

export fn sentiment_report texts
    results: batch_sentiment texts
    counts: {}
    for r in results
        c: get counts r
        if is_nil c; c: 0
        set counts r (c + 1)
    counts
